APP_NAME=OptiGest
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Guatemala
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---------------------------------------------------------------------
# Base de datos PostgreSQL
# ---------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=optigest
DB_USERNAME=postgres
DB_PASSWORD=change_me

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

QUEUE_CONNECTION=sync
CACHE_STORE=file

# ---------------------------------------------------------------------
# Correo (usado para recuperacion de contrasena). Para pruebas locales
# se recomienda una cuenta gratuita de Mailtrap (sandbox SMTP).
# ---------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@cadiliompa.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------
# Inventario: umbral global de alerta de bajo stock (puede sobreescribirse
# por material mediante la columna stock_minimo)
# ---------------------------------------------------------------------
INVENTARIO_STOCK_MINIMO_DEFAULT=10

# ---------------------------------------------------------------------
# Modulo de Agente Inteligente (asistente IA del sistema)
# Se utiliza la API de Anthropic (Claude) para responder consultas
# gerenciales en lenguaje natural sobre cotizaciones, inventario y tickets.
# ---------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---------------------------------------------------------------------
# Google reCAPTCHA v2 (checkbox "No soy un robot")
# Obtener llaves en https://www.google.com/recaptcha/admin/create
# ---------------------------------------------------------------------
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

BCRYPT_ROUNDS=12
